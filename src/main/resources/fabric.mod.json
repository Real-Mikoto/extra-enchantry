{
	"schemaVersion": 1,
	"id": "extra-enchantry",
	"version": "${version}",
	"name": "Extra Enchantry",
	"description": "Extra Enchantry adds 40 custom enchantments for Minecraft 26.2 (Fabric) - from Limit Break and Emberfall to the Cataclysm of Realms challenge, the accessory system with family gems, wolf armor enchanting and fire-family fire immunity.",
	"authors": [
		"RealMikoto"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/extra-enchantry",
		"sources": "https://github.com/Real-Mikoto/extra-enchantry",
		"issues": "https://github.com/Real-Mikoto/extra-enchantry/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/extra-enchantry/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"realmikoto.extraenchantry.ExtraEnchantry"
		],
		"client": [
			"realmikoto.extraenchantry.client.ExtraEnchantryClient"
		]
	},
	"mixins": [
		"extra-enchantry.mixins.json",
		{
			"config": "extra-enchantry.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}